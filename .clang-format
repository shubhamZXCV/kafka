# Project code style. Run: clang-format -i <files>
BasedOnStyle: Google
Language: Cpp
Standard: c++20

IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4          # `public:` flush with `class`
NamespaceIndentation: None
DerivePointerAlignment: false
PointerAlignment: Left            # int* p, not int *p

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Include order: matching header, C system, C++ standard, third-party, project.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+\.h>$'       # C system headers
    Priority: 1
  - Regex: '^<(sys|netinet|arpa)/[a-z_]+\.h>$'   # C system headers in subdirectories
    Priority: 1
  - Regex: '^<[a-z_]+>$'          # C++ standard library
    Priority: 2
  - Regex: '^"elog/'              # project headers
    Priority: 4
  - Regex: '.*'                   # third-party
    Priority: 3
